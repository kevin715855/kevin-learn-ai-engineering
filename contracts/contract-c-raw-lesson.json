{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Contract C - Raw Lesson Package",
  "type": "object",
  "properties": {
    "lesson_id": { "type": "string" },
    "slug": { "type": "string" },
    "download_url": { "type": "string", "format": "uri" },
    "status_code": { "type": "integer" },
    "headers": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "fetched_at": { "type": "string" },
    "content": { "type": "string" }
  },
  "required": ["lesson_id", "slug", "download_url", "status_code", "headers", "fetched_at", "content"]
}
