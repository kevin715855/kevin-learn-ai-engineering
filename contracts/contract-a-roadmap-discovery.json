{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Contract A - Roadmap Discovery Structure",
  "type": "object",
  "properties": {
    "total_modules": {
      "type": "integer",
      "minimum": 0
    },
    "total_lessons": {
      "type": "integer",
      "minimum": 0
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "slug": { "type": "string" },
          "lessons": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "title": { "type": "string" },
                "slug": { "type": "string" },
                "module_id": { "type": "string" },
                "module_title": { "type": "string" },
                "download_url": { "type": "string", "format": "uri" },
                "y_pos": { "type": "number" }
              },
              "required": ["id", "title", "slug", "module_id", "module_title", "download_url"]
            }
          }
        },
        "required": ["id", "title", "slug", "lessons"]
      }
    },
    "lessons": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "slug": { "type": "string" },
          "module_id": { "type": "string" },
          "module_title": { "type": "string" },
          "download_url": { "type": "string", "format": "uri" },
          "y_pos": { "type": "number" }
        },
        "required": ["id", "title", "slug", "module_id", "module_title", "download_url"]
      }
    }
  },
  "required": ["total_modules", "total_lessons", "modules", "lessons"]
}
