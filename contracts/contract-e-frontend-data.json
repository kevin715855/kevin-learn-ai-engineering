{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Contract E - Frontend Roadmap Data",
  "type": "object",
  "properties": {
    "total_modules": {
      "type": "integer",
      "minimum": 0
    },
    "total_lessons": {
      "type": "integer",
      "minimum": 0
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "slug": { "type": "string" },
          "title": { "type": "string" },
          "lessons": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "slug": { "type": "string" },
                "title": { "type": "string" },
                "original_title": { "type": "string" },
                "content": { "type": "string" },
                "filename": { "type": "string" }
              },
              "required": ["id", "slug", "title", "content", "filename"]
            }
          }
        },
        "required": ["id", "slug", "title", "lessons"]
      }
    }
  },
  "required": ["total_modules", "total_lessons", "modules"]
}
