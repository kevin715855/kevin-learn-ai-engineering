{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Contract B - Crawl State Record",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "slug": { "type": "string" },
    "title": { "type": "string" },
    "module_id": { "type": ["string", "null"] },
    "module_title": { "type": ["string", "null"] },
    "status": {
      "type": "string",
      "enum": ["PENDING", "FETCHING", "COMPLETED", "FAILED"]
    },
    "error_message": { "type": ["string", "null"] },
    "raw_file_path": { "type": ["string", "null"] },
    "updated_at": { "type": "string" }
  },
  "required": ["id", "slug", "title", "status"]
}
